# Copy this file to backend/.env and change the values you need.
# Never commit backend/.env; it can contain secrets.

# One of: development, test, production
APP_ENV=development

# SQLAlchemy URL for PostgreSQL, using the psycopg driver
DATABASE_URL=postgresql+psycopg://interact:interact@localhost:5432/interact

# Which LLM the app uses: "fake" (predictable replies, no model needed) or
# "openai_compatible" (Ollama, Groq, Gemini, OpenRouter, ...).
LLM_PROVIDER=fake

# OpenAI-compatible LLM endpoint. These defaults point at a local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=interact-llama3.1:8b
# Ollama ignores the key; hosted providers need a real one.
LLM_API_KEY=ollama

# Seconds to wait for one reply, retries for network errors, timeouts,
# HTTP 429 and 5xx, and sampling temperature (lower is more consistent).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# How generated questions are checked against their requested style:
# "rules" (instant checks only) or "rules_and_llm" (adds one short LLM call).
STYLE_CHECK=rules_and_llm

# Uploaded documents (Model B): a private folder on the server, and the size limit.
# Leave UPLOAD_DIR empty for backend/uploads.
UPLOAD_DIR=
MAX_UPLOAD_MB=20

# Where people open the app. Sign-in providers return users to
# PUBLIC_URL/api/v1/auth/<provider>/callback, so register exactly that URL.
PUBLIC_URL=http://localhost:5173

# Signs the session cookie. Leave empty in development. In production set a
# random value of at least 32 characters, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Days a sign-in lasts before the user must sign in again.
SESSION_MAX_AGE_DAYS=14

# Development only: offer "Sign in as a local test user" so the app works
# without OAuth apps. Ignored unless APP_ENV is development.
DEV_LOGIN=true

# OAuth apps (see docs/oauth-setup.md). Leave a provider empty to hide it.
# Never commit real values: this file is an example; secrets go in backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

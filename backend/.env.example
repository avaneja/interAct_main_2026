# Copy this file to backend/.env and change the values you need.
# Never commit backend/.env; it can contain secrets.

# One of: development, test, production
APP_ENV=development

# SQLAlchemy URL for PostgreSQL, using the psycopg driver
DATABASE_URL=postgresql+psycopg://interact:interact@localhost:5432/interact

# OpenAI-compatible LLM endpoint. These defaults point at a local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# Ollama ignores the key; hosted providers need a real one.
LLM_API_KEY=ollama
